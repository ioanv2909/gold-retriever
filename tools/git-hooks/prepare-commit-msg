#!/bin/sh
# Prefixeaza mesajul de commit cu versiunea (ex. "v0.2.4: ...").
case "$2" in merge|squash|commit) exit 0 ;; esac
last=$(git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null) || exit 0
n=$(git rev-list --count "$last"..HEAD)
base=${last#v}
ver="${base%.*}.$(( ${base##*.} + n + 1 ))"
case "$(head -n1 "$1")" in v[0-9]*) exit 0 ;; esac
sed -i "1s/^/v$ver: /" "$1"
